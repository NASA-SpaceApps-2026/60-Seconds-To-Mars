# Copia este archivo como .env.local y pon tus claves (NUNCA subas .env.local a Git).
# Sin clave de Gemini el juego funciona igual con los eventos de respaldo (fallback).
# Esta clave SOLO se usa en `npm run dev`. En producción se usa el proxy /api/gemini.
VITE_GEMINI_API_KEY=
VITE_NASA_API_KEY=DEMO_KEY
VITE_GEMINI_MODEL=gemini-3.1-flash-lite
